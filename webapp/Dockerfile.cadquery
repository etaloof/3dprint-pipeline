FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 libfreetype6 libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir cadquery>=2.4.0 numpy-stl

WORKDIR /worker
COPY webapp/backend/app/services/cadquery_runner.py /worker/
ENV DATA_DIR=/data
VOLUME ["/data"]

CMD ["python3", "-c", "print('CadQuery worker ready')"]
