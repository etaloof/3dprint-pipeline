# Jarvis Onshape MCP (Tailscale SSE endpoint)
MCP_SSE_URL=https://nativedev.tail7d3518.ts.net:10001/sse

# Claude: auto | cli | api | demo
CLAUDE_MODE=auto
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_S=600

# Optional Anthropic API key (Mode B)
